PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb://mongo:27017/fashionstore
CLIENT_URL=http://localhost:3000

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

VNP_TMN_CODE=your_vnpay_tmn_code
VNP_HASH_SECRET=your_vnpay_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/api/payment/vnpay/callback

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
PAYPAL_RETURN_URL=http://localhost:3000/payment/paypal/callback
PAYPAL_CANCEL_URL=http://localhost:3000/payment/paypal/cancel

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME=FashionStore
BREVO_API_KEY=

GHN_TOKEN=your_ghn_token
GHN_SHOP_ID=
GHN_BASE_URL=https://online-gateway.ghn.vn/shiip/public-api/v2
GHN_FROM_DISTRICT_ID=
GHN_FROM_WARD_CODE=

HF_TOKEN=
AI_TRY_ON_TIMEOUT_MS=180000
VIRTUAL_TRY_ON_MAX_UPLOAD_MB=10
VIRTUAL_TRY_ON_MAX_REMOTE_IMAGE_MB=10
VIRTUAL_TRY_ON_UPLOAD_TO_CLOUDINARY=true

VITE_API_BASE_URL=/api
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id



